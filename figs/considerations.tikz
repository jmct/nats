% Mutexes vs atomics, good vs bad: a loose two-by-two of considerations.
% Needs in the preamble:  \usepackage{tikz}
% Use with:               \input{figs/considerations.tikz}
\begin{tikzpicture}[
  axis/.style={lucid-blue, line width=1pt, line cap=round},
  head/.style={my-magenta, font=\Large, inner sep=1pt},
  item/.style={my-magenta, font=\small, align=center, inner sep=1pt},
]
  %% ---- axes --------------------------------------------------------------
  \draw[axis] ( 0.1,  2.9) -- ( 0.1, -3.1);
  \draw[axis] (-4.2,  0.0) -- ( 5.0,  0.0);

  %% ---- axis labels -------------------------------------------------------
  \node[head, rotate= 2] at (-2.0,  3.2) {Mutexes / locks};
  \node[head, rotate=-3] at ( 2.7,  3.4) {Atomic operations};
  \node[head, rotate= 4] at (-4.5,  1.4) {Good};
  \node[head, rotate=-5] at (-4.5, -1.5) {Bad};

  %% ---- mutexes, good -----------------------------------------------------
  \node[item, rotate= 7] at (-1.4,  2.2) {protects arbitrary\\structures};
  \node[item, rotate=-3] at (-2.8,  1.3) {simple\\mental model};
  \node[item, rotate= 4] at (-1.3,  0.5) {good debugging\\tools};

  %% ---- atomics, good -----------------------------------------------------
  \node[item, rotate= 9] at ( 1.6,  2.2) {preempted threads\\don't block};
  \node[item, rotate=-3] at ( 4.0,  2.3) {no deadlocks};
  \node[item, rotate=-6] at ( 3.3,  1.0) {cheap when\\uncontested};

  %% ---- mutexes, bad ------------------------------------------------------
  \node[item, rotate=-2] at (-2.9, -0.6) {deadlocks};
  \node[item, rotate= 6] at (-3.3, -2.1) {convoying\\(serialization)};
  \node[item, rotate= 5] at (-1.5, -2.6) {priority inversion};

  %% ---- atomics, bad ------------------------------------------------------
  \node[item, rotate= -8] at ( 1.6, -0.5) {starvation};
  \node[item, rotate=  4] at ( 1.3, -1.6) {architecture\\dependent};
  \node[item, rotate=-12] at ( 3.9, -1.2) {single-word;\\scaling difficult};
  \node[item, rotate= -3] at ( 3.0, -2.5) {spinning computationally\\wasteful};
\end{tikzpicture}
