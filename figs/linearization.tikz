% Six atomic blocks laid out in one linear order, revealed step by step.
% Needs in the preamble:  \usepackage{tikz}
%                         \input{figs/linearization.tikz}
% Use in a frame with:    \linearization            stack builds on overlays 1-6
%                         \linearization[aside]     ... then "But..." on 7, callout on 8
%                         \linearization[static]    everything at once, no overlays
%                         \linearization[aside, static]
% The bounding box is fixed, so nothing shifts as the picture builds.
\newif\iflinearizationaside
\newif\iflinearizationstatic
\pgfkeys{/linearization/.is family, /linearization,
  aside/.is if=linearizationaside,
  static/.is if=linearizationstatic,
}
% beamer overlays inside TikZ: visible on=<spec> hides a node/path until then
\tikzset{
  invisible/.style={opacity=0, text opacity=0, fill opacity=0},
  visible on/.style={alt={#1{}{invisible}}},
  alt/.code args={<#1>#2#3}{%
    \alt<#1>{\pgfkeysalso{#2}}{\pgfkeysalso{#3}}%
  },
}
\newcommand{\linearization}[1][]{%
\linearizationasidefalse
\linearizationstaticfalse
\pgfkeys{/linearization, #1}%
\begin{tikzpicture}[
  line width=0.8pt,
  % the three tints, at the opacities used for the atomic blocks
  tintA/.style={fill=lucid-blue,    fill opacity=0.28},
  tintB/.style={fill=galois-yellow, fill opacity=0.45},
  tintC/.style={fill=my-magenta,    fill opacity=0.28},
  cell/.style={draw=none, rectangle, minimum width=2.4cm, minimum height=0.72cm,
               inner sep=0pt, outer sep=0pt, text=dark-gray, text opacity=1},
  but/.style={my-magenta, font=\Large, inner sep=1pt},
  callout/.style={my-magenta, font=\large, align=left, inner sep=2pt},
  frame/.style={dark-gray, line width=0.6pt, line cap=round},
]
  % reveal=<n>: appear from overlay n on, unless the picture is static
  \iflinearizationstatic
    \tikzset{reveal/.style={}}
  \else
    \tikzset{reveal/.style={visible on=<##1->}}
  \fi
  \useasboundingbox (-5.0, -2.7) rectangle (5.4, 2.7);
%
  %% ---- the linear order, one block per step ------------------------------
  % colours deliberately do not cycle: B and A each appear twice in a row
  \foreach [count=\i] \t in {A, B, B, C, A, A}
    \node[cell, tint\t, reveal=\i] at (-3.5, {2.64 - 0.78*\i}) {$c_\i$};
%
  %% ---- the aside, two more steps -----------------------------------------
  \iflinearizationaside
    \node[but, reveal=7] at (0.1, 0.1) {But\,\dots};
    \draw[frame, reveal=8] (1.6, 1.55) -- (5.2, 1.55)
                           (1.6, 1.55) -- (1.6, -1.35)
                           (1.6, -1.35) -- (5.2, -1.35);
    \node[callout, reveal=8, anchor=west] at (1.9, 0.1)
      {How does $c_2$ know\\it's not gonna\\conflict?};
  \fi
\end{tikzpicture}%
}
