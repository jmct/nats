% Three callers contending for one lock that guards a resource.
% Needs in the preamble:  \usepackage{tikz}
%                         \usetikzlibrary{arrows.meta,shapes.symbols}
% Use with:               \input{figs/mutex.tikz}
\begin{tikzpicture}[
  line width=0.8pt,
  code/.style={font=\ttfamily, text=dark-gray, inner sep=2pt},
  % callers reaching for the lock
  ref/.style={dark-gray, -{Stealth[length=6pt]}, line width=0.9pt},
  % the lock's access to the resource
  ptr/.style={dark-lucid-blue, -{Stealth[length=6pt]}},
  lockbox/.style={draw=dark-lucid-blue, rectangle, minimum size=1.2cm, inner sep=0pt},
  resource/.style={draw=my-magenta, cloud, cloud puffs=11, cloud ignores aspect,
                   minimum width=3.2cm, minimum height=2.1cm, inner sep=0pt,
                   text=my-magenta},
]
  %% ---- helpers -----------------------------------------------------------
  % \padlock{x}{y}: a small padlock centred at (x,y)
  \newcommand{\padlock}[2]{%
    \draw[dark-lucid-blue, fill=dark-lucid-blue]
      (#1-0.22, #2-0.26) rectangle (#1+0.22, #2+0.02);
    \draw[dark-lucid-blue, line width=1.1pt]
      (#1-0.13, #2+0.02) -- (#1-0.13, #2+0.14)
      arc[start angle=180, end angle=0, radius=0.13]
      -- (#1+0.13, #2+0.02);
  }
  % \key{x}{y}: a small key centred at (x,y), lying on its side
  \newcommand{\key}[2]{%
    \begin{scope}[shift={(#1,#2)}, rotate=-30, dark-lucid-blue, line width=0.9pt]
      \draw (-0.42,0) circle[radius=0.14];
      \draw (-0.28,0) -- (0.42,0)
            (0.42,0) -- (0.42,-0.14)
            (0.26,0) -- (0.26,-0.10);
    \end{scope}
  }

  %% ---- the callers -------------------------------------------------------
  \node[code, anchor=east] (f1) at (-3.8,  1.3) {f1};
  \node[code, anchor=east] (f2) at (-3.8,  0.0) {f2};
  \node[code, anchor=east] (f3) at (-3.8, -1.3) {f3};
  \key{-3.1}{-1.5}

  %% ---- the lock ----------------------------------------------------------
  \node[lockbox] (lock) at (0,0) {};
  \padlock{0}{0}

  %% ---- the resource ------------------------------------------------------
  \node[resource] (res) at (4.3,0) {Resource};

  %% ---- edges -------------------------------------------------------------
  \draw[ref] (f1.east) to[out=0,   in=140] (lock.north west);
  \draw[ref] (f2.east) --                  (lock.west);
  \draw[ref] ([xshift=30pt]f3.east) to[out=0, in=-140] (lock.south west);
  \draw[ptr] (lock.east) -- (res.west);
\end{tikzpicture}
